# API and chat server (use the same database and JWT secret for both)
APP_ENV=development
DB_HOST=your-supabase-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-your-supabase-database-password
DB_SSLMODE=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Browser build; leave these unset for the local Vite/XAMPP defaults
VITE_API_BASE_URL=
VITE_CHAT_SERVER_URL=

# Optional local development server controls. Render sets PORT automatically.
CHAT_HOST=0.0.0.0
CHAT_PORT=3001
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_STRICT_PORT=0
VITE_DEV_HTTPS=0
VITE_AUTO_CHAT_SERVER=1

# API and chat server (use the same database and JWT secret for both)
APP_ENV=development
DB_HOST=your-supabase-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-your-supabase-database-password
DB_SSLMODE=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Password reset email. Configure an SMTP provider (for example, a Gmail app
# password or transactional email service). Without these, PHP uses its local
# mail transport, which must be configured in XAMPP's php.ini/sendmail setup.
MAIL_FROM=no-reply@your-domain.example
MAIL_FROM_NAME=Telemed ZM
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls

# WebRTC video calling. STUN is safe to expose; do not put long-lived TURN
# credentials in a VITE_ variable because frontend values are public.
VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Browser build; leave these unset for the local Vite/XAMPP defaults
VITE_API_BASE_URL=
VITE_CHAT_SERVER_URL=

# Optional local development server controls. Render sets PORT automatically.
CHAT_HOST=0.0.0.0
CHAT_PORT=4310
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_STRICT_PORT=0
VITE_DEV_HTTPS=0
VITE_AUTO_CHAT_SERVER=1
